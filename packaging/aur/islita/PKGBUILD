# Maintainer: Harvey Xia <https://github.com/harveyxiacn>
#
# Builds from the tagged source, doing by hand what `scripts/install-linux.sh`
# does per user: `pnpm tauri build --no-bundle`, then install the binary, the
# launcher entry and the icons.
#
# Heads-up for a clean-chroot build (`extra-x86_64-build`): build() downloads
# the npm and crates.io dependencies, so it needs network access. Run makepkg
# normally, or pre-populate the pnpm/cargo caches.
#
# Before publishing: bump pkgver, run `updpkgsums`, then
# `makepkg --printsrcinfo > .SRCINFO`.

pkgname=islita
pkgver=0.2.0
pkgrel=1
pkgdesc='Plugin island for the desktop with AI quotas, mail, calendar, notes, files, music and tasks'
arch=('x86_64' 'aarch64')
url='https://github.com/harveyxiacn/islita'
license=('MIT')
depends=('webkit2gtk-4.1' 'libayatana-appindicator' 'librsvg' 'gtk3')
makedepends=('rust' 'nodejs' 'pnpm')
optdepends=(
  'gnome-shell-extension-appindicator: tray icon on GNOME'
  'gtk-layer-shell: native Wayland docking (ISLITA_BACKEND=wayland)'
)
conflicts=("$pkgname-bin")
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('dd903b15702c34f8884bda1d287b316ece7c8ad359799f46f1702350c4fc32d0')

_srcdir="islita-$pkgver"

build() {
  cd "$_srcdir"
  export PNPM_HOME="$srcdir/.pnpm"
  export CARGO_HOME="${CARGO_HOME:-$srcdir/.cargo}"
  pnpm install --frozen-lockfile
  # --no-bundle: this PKGBUILD *is* the packaging, no .deb/.AppImage needed.
  # --locked mirrors CI so the build cannot silently pick newer crates.
  pnpm tauri build --no-bundle -- --locked
}

check() {
  cd "$_srcdir/src-tauri"
  cargo test --locked --release
}

package() {
  cd "$_srcdir"
  install -Dm755 "src-tauri/target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

  # Same icon sizes and the same StartupWMClass as scripts/install-linux.sh.
  local size source_icon
  for size in 32 64 128 256 512; do
    case $size in
      32) source_icon=32x32.png ;;
      64) source_icon=64x64.png ;;
      128) source_icon=128x128.png ;;
      256) source_icon='128x128@2x.png' ;;
      512) source_icon=icon.png ;;
    esac
    install -Dm644 "src-tauri/icons/$source_icon" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/$pkgname.png"
  done

  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/$pkgname.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Islita
Name[zh_CN]=Islita
Comment=Plugin island for AI quotas, mail, calendar, notes, files, music and tasks
Comment[zh_CN]=插件灵动岛：AI 额度、邮件、日程、便利贴、文件、音乐与任务
Exec=/usr/bin/$pkgname
Icon=$pkgname
Terminal=false
Categories=Utility;
StartupNotify=true
StartupWMClass=$pkgname
EOF
}
